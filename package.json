{
  "name": "cr-mapa",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Costa Rica · Atlas interactivo (Vite + React + TypeScript + MapLibre GL)",
  "scripts": {
    "predev": "node scripts/build-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-data.mjs && node scripts/audit-quality.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md,ts,js}\"",
    "fetch-content": "node scripts/fetch-content.mjs",
    "build-data": "node scripts/build-data.mjs",
    "fetch-osm": "node scripts/fetch-content.mjs --osm-only",
    "fetch-crests": "node scripts/fetch-content.mjs --crests",
    "fetch-photos": "node scripts/fetch-photos.mjs",
    "fetch-food-photos": "node scripts/fetch-food-photos.mjs",
    "prepare": "husky",
    "enrich-es": "node scripts/enrich-es-content.mjs",
    "audit-lang": "node scripts/audit-lang.mjs",
    "fetch-fauna": "node scripts/fetch-fauna-media.mjs",
    "patch-fauna-content": "node scripts/archive/patch-content-fauna.mjs",
    "audit-quality": "node scripts/audit-quality.mjs",
    "audit-remote": "node scripts/audit-remote.mjs",
    "sync-media": "node scripts/sync-media-r2.mjs",
    "sync-media:upload": "node scripts/sync-media-r2.mjs --upload",
    "mirror-media": "node scripts/mirror-remote-media.mjs",
    "mirror-media:dry": "node scripts/mirror-remote-media.mjs --dry-run",
    "fetch-missing-media": "node scripts/fetch-missing-media.mjs",
    "snap-fauna-prov": "node scripts/snap-fauna-prov.mjs",
    "e2e": "node scripts/e2e.mjs",
    "enrich-thin-desc": "node scripts/enrich-thin-desc.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "aws4fetch": "^1.0.20"
  }
}
