{
  "name": "cr-mapa",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Costa Rica · Atlas interactivo (Vite + React + TypeScript + MapLibre GL)",
  "scripts": {
    "predev": "node scripts/build-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-data.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md,ts,js}\"",
    "fetch-content": "node scripts/fetch-content.mjs",
    "build-data": "node scripts/build-data.mjs",
    "fetch-osm": "node scripts/fetch-content.mjs --osm-only",
    "fetch-crests": "node scripts/fetch-content.mjs --crests",
    "fetch-photos": "node scripts/fetch-photos.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
